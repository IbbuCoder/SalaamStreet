 "mailer_subjects_magic_link": "Your SalaamStreet sign-in code: {{ .Token }}",
 "mailer_templates_magic_link_content": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your sign-in code</title></head>\n<body style=\"margin:0;padding:0;background:#f6faf7\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6faf7\"><tr><td align=\"center\" style=\"padding:28px 12px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#ffffff;border:1px solid #dbe6df;border-radius:18px;font-family:Figtree,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#0b1210\">\n<tr><td align=\"center\" style=\"padding:28px 24px 8px\"><img src=\"https://salaamstreet.com/icons/brand/logo-mark-128.png\" width=\"56\" height=\"56\" alt=\"\" style=\"display:block;border-radius:14px\">\n<div style=\"margin-top:10px;font-size:18px;font-weight:800;color:#047857\">SalaamStreet</div></td></tr>\n<tr><td style=\"padding:8px 28px 0;text-align:center\">\n<h1 style=\"margin:8px 0 6px;font-size:22px;line-height:1.3\">Your sign-in code</h1>\n<p style=\"margin:0;font-size:15px;line-height:1.55;color:#425249\">Enter this code in SalaamStreet to sign in.</p></td></tr>\n<tr><td align=\"center\" style=\"padding:20px 28px 6px\">\n<div style=\"display:inline-block;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:14px;padding:14px 22px;font-size:32px;font-weight:800;letter-spacing:8px;color:#047857;font-family:'SFMono-Regular',Menlo,Consolas,monospace\">{{ .Token }}</div>\n<p style=\"margin:10px 0 0;font-size:13px;color:#64746b\">This code works once and expires soon.</p></td></tr>\n<tr><td align=\"center\" style=\"padding:18px 28px 4px\">\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#047857;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;padding:12px 26px;border-radius:12px\">Sign in</a>\n<p sty