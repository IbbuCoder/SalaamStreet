	<string>SalaamStreet uses your location to work out prayer times, the Qibla direction and nearby mosques. It is only used on your iPhone.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera is only used in Qibla camera mode, to show the Qibla direction over the view in front of you. Nothing is recorded or sent.</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.salaamstreet.app.prayer</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Prayer Times</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>clock</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>hash</key>
				<string>#/prayer</string>
			</dict>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.salaamstreet.app.qibla</string>
			<key>UIApplicationShortcutItemTitle</key>
